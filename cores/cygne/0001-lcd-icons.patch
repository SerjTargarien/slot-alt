Slot²: give a frontend the LCD's icon byte (port 0x15), which a game lights to say how
the console is held (bit 1 vertical, bit 2 horizontal), as memory id 0x5715. Slot²
turns the picture to follow it (design/ws-orientation.md).

diff --git a/libretro.c b/libretro.c
index aaadf48..20d4812 100644
--- a/libretro.c
+++ b/libretro.c
@@ -1718,6 +1718,10 @@ bool retro_unserialize(const void *data, size_t size)
    return MDFNSS_LoadSM(&st, 0, 0);
 }
 
+/* Slot²: the LCD's icon byte, for a frontend to follow the way a game is held. An id
+ * past libretro's own memory types, so no other frontend asks for it. */
+#define SLOT_MEMORY_LCD_ICONS 0x5715
+
 void *retro_get_memory_data(unsigned type)
 {
    switch (type)
@@ -1732,6 +1736,8 @@ void *retro_get_memory_data(unsigned type)
          break;
       case RETRO_MEMORY_SYSTEM_RAM:
          return (uint8_t*)wsRAM;
+      case SLOT_MEMORY_LCD_ICONS:
+         return WSwan_GfxIcons();
       default:
          break;
    }
@@ -1757,6 +1763,8 @@ size_t retro_get_memory_size(unsigned type)
          break;
       case RETRO_MEMORY_SYSTEM_RAM:
          return wsRAMSize;
+      case SLOT_MEMORY_LCD_ICONS:
+         return 1;
       default:
          break;
    }
diff --git a/mednafen/wswan/gfx.c b/mednafen/wswan/gfx.c
index d1d5ee7..dbe8ed2 100644
--- a/mednafen/wswan/gfx.c
+++ b/mednafen/wswan/gfx.c
@@ -55,6 +55,13 @@ static uint8 SPRx0, SPRy0, SPRx1, SPRy1;
 static uint8 BGXScroll, BGYScroll;
 static uint8 FGXScroll, FGYScroll;
 static uint8 LCDControl, LCDIcons;
+
+/* Slot²: the LCD's icon segments (port 0x15), which a game lights to say how the
+ * console is held: bit 1 vertical, bit 2 horizontal. */
+uint8 *WSwan_GfxIcons(void)
+{
+   return &LCDIcons;
+}
 static uint8 LCDVtotal;
 
 static uint8 BTimerControl;
diff --git a/mednafen/wswan/gfx.h b/mednafen/wswan/gfx.h
