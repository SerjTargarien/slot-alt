#!/bin/sh
# Base² has no systemd. slot asks timedatectl only whether network time is on and to
# switch it (slot-power's set_ntp), so this answers those two with BusyBox ntpd.
PIDFILE=/run/ntpd.pid
SERVER=pool.ntp.org

running() {
	[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2> /dev/null
}

case "$*" in
"show -p NTP --value")
	if running; then echo yes; else echo no; fi
	;;
"set-ntp yes" | "set-ntp true" | "set-ntp 1")
	running && exit 0
	# ntpd keeps retrying while Wi-Fi is off, and writes the RTC on each sync.
	setsid ntpd -n -p "$SERVER" -S /etc/basesq/ntp-synced < /dev/null > /dev/null 2>&1 &
	echo $! > "$PIDFILE"
	;;
"set-ntp no" | "set-ntp false" | "set-ntp 0")
	running && kill "$(cat "$PIDFILE")"
	rm -f "$PIDFILE"
	;;
*)
	echo "timedatectl on Base² knows only 'show -p NTP --value' and 'set-ntp yes|no'" >&2
	exit 1
	;;
esac
