# What slot needs to know about this device (crates/slot/src/hardware.rs). Missing keys
# keep what slot does on BaseOS.
NAME="slot² RGB20SX"
# The Mali GBM build on DRM/KMS; BaseOS uses fbdev.
DISPLAY=kms
# Gamepad key codes (BTN_SOUTH and so on), not Anbernic's.
BUTTONS=gamepad
# Our kernel reports FN as a key. The frontend sets SLOT_FN_ADC when ROCKNIX's kernel runs,
# which drops it.
FN_ADC=
CPU_CAP=1
# slot leaves Wi-Fi to the OS until the device layer's step 2 (tools/rocknix/HANDOFF.md).
WIFI=0
BOOT_LOGO=0
